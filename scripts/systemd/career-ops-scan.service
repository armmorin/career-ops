[Unit]
Description=Career Ops Hub and employer-board scan
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/armando/career-ops
Environment=HOME=/home/armando
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/armando/career-ops/scripts/hub-scan-timer.sh
TimeoutStartSec=90min
