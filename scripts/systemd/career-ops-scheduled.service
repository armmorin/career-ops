[Unit]
Description=Career Ops search at boot on a scheduled day

[Service]
Type=oneshot
WorkingDirectory=/home/armando/career-ops
Environment=HOME=/home/armando
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/armando/career-ops/scripts/scheduled-boot.sh
TimeoutStartSec=180min

[Install]
WantedBy=default.target
