[Unit]
Description=Career Ops LinkedIn alert mail
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/armando/career-ops
Environment=HOME=/home/armando
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/armando/career-ops/scripts/linkedin-alert-mail-timer.sh
TimeoutStartSec=20min
